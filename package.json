{
  "name": "dsh-clear-tool-results",
  "version": "0.7.0",
  "author": "stultuss",
  "description": "DeepSeek Harness host plugin: archive raw tool results into the session folder, clear them from the visible conversation at round boundaries, and let the model recall them through a read_tool_result_log tool.",
  "homepage": "https://github.com/stultuss/dsh-clear-tool-results#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stultuss/dsh-clear-tool-results.git"
  },
  "bugs": "https://github.com/stultuss/dsh-clear-tool-results/issues",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {},
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "tool-result",
    "compaction",
    "context"
  ],
  "license": "MIT"
}
