{
  "name": "dsh-clear-tool-results",
  "version": "0.8.3",
  "author": "stultuss",
  "description": "DeepSeek Harness host plugin: admission-filter tool results before they enter the context — oversized plain-text results are persisted to the session folder and the model receives a receipt with an absolute path, retrievable with the built-in read/grep tools.",
  "homepage": "https://github.com/stultuss/dsh-clear-tool-results#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stultuss/dsh-clear-tool-results.git"
  },
  "bugs": "https://github.com/stultuss/dsh-clear-tool-results/issues",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "tool-result",
    "compaction",
    "context"
  ],
  "license": "MIT"
}
